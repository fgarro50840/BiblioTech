
@model IEnumerable<BiblioTech.Models.Autor>

@{
    ViewData["Title"] = "Autores";
}

<div class="page-header">
    <div>
        <h1>Gestión de autores</h1>
        <p>Consulte y administre los autores de la biblioteca.</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i>
        Nuevo autor
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        <i class="bi bi-check-circle"></i>
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle"></i>
        @TempData["Error"]
    </div>
}

<div class="content-card">

    <form method="get" asp-action="Index"
          class="row g-3 mb-4">

        <div class="col-md-9">
            <input type="text"
                   name="buscar"
                   value="@ViewBag.Buscar"
                   class="form-control"
                   placeholder="Buscar por nombre, apellido o nacionalidad..." />
        </div>

        <div class="col-md-3">
            <button type="submit"
                    class="btn btn-primary w-100">
                <i class="bi bi-search"></i>
                Buscar
            </button>
        </div>

    </form>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Nacionalidad</th>
                    <th>Correo</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var autor in Model)
                {
                    <tr>
                        <td>@autor.Nombre</td>
                        <td>@autor.Apellido</td>
                        <td>@autor.Nacionalidad</td>
                        <td>@autor.Correo</td>

                        <td class="text-end">
                            <a asp-action="Edit"
                               asp-route-id="@autor.Id"
                               class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil"></i>
                                Editar
                            </a>

                            <form asp-action="Delete"
                                  asp-route-id="@autor.Id"
                                  method="post"
                                  class="d-inline"
                                  onsubmit="return confirm('¿Está seguro de eliminar este autor?');">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                    Eliminar
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-person-x fs-1"></i>
            <p class="mt-3">
                No se encontraron autores registrados.
            </p>
        </div>
    }

</div>

