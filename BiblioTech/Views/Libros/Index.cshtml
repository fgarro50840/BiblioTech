
@model IEnumerable<BiblioTech.Models.Libro>

@{
    ViewData["Title"] = "Libros";
}

<div class="page-header">
    <div>
        <h1>Gestión de libros</h1>
        <p>Administre el catálogo de libros de la biblioteca.</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i>
        Nuevo libro
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        <i class="bi bi-check-circle"></i>
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle"></i>
        @TempData["Error"]
    </div>
}

<div class="content-card">

    <form method="get" asp-action="Index"
          class="row g-3 mb-4">

        <div class="col-md-9">
            <input type="text"
                   name="buscar"
                   value="@ViewBag.Buscar"
                   class="form-control"
                   placeholder="Buscar por título, ISBN o autor..." />
        </div>

        <div class="col-md-3">
            <button type="submit"
                    class="btn btn-primary w-100">
                <i class="bi bi-search"></i>
                Buscar
            </button>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Título</th>
                    <th>ISBN</th>
                    <th>Autor</th>
                    <th>Año</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var libro in Model)
                {
                    <tr>
                        <td>
                            <strong>@libro.Titulo</strong>
                        </td>

                        <td>@libro.ISBN</td>

                        <td>
                            @libro.Autor.Nombre
                            @libro.Autor.Apellido
                        </td>

                        <td>@libro.AnioPublicacion</td>

                        <td>
                            @if (libro.Disponible)
                            {
                                <span class="badge bg-success">
                                    <i class="bi bi-check-circle"></i>
                                    Disponible
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">
                                    <i class="bi bi-clock"></i>
                                    Prestado
                                </span>
                            }
                        </td>

                        <td class="text-end">
                            <a asp-action="Edit"
                               asp-route-id="@libro.Id"
                               class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil"></i>
                                Editar
                            </a>

                            <form asp-action="Delete"
                                  asp-route-id="@libro.Id"
                                  method="post"
                                  class="d-inline"
                                  onsubmit="return confirm('¿Está seguro de eliminar este libro?');">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                    Eliminar
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-book fs-1"></i>
            <p class="mt-3">
                No se encontraron libros registrados.
            </p>
            <a asp-action="Create"
               class="btn btn-primary">
                Registrar primer libro
            </a>
        </div>
    }

</div>
