
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BiblioTech</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    <div class="app-container">

        <!-- Menú de manera lateral -->
        <aside class="sidebar" id="sidebar">

            <div class="sidebar-brand">
                <i class="bi bi-book-half"></i>
                <span>BiblioTech</span>
            </div>

            <div class="sidebar-subtitle">
                Biblioteca Digital
            </div>

            <nav class="sidebar-nav">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="nav-link-custom">
                    <i class="bi bi-grid-1x2"></i>
                    <span>Inicio</span>
                </a>

                <a asp-controller="Libros"
                   asp-action="Index"
                   class="nav-link-custom">
                    <i class="bi bi-book"></i>
                    <span>Libros</span>
                </a>

                <a asp-controller="Autores"
                   asp-action="Index"
                   class="nav-link-custom">
                    <i class="bi bi-pencil-square"></i>
                    <span>Autores</span>
                </a>

                <a asp-controller="Usuarios"
                   asp-action="Index"
                   class="nav-link-custom">
                    <i class="bi bi-people"></i>
                    <span>Usuarios</span>
                </a>

                <a asp-controller="Prestamos"
                   asp-action="Index"
                   class="nav-link-custom">
                    <i class="bi bi-arrow-left-right"></i>
                    <span>Préstamos</span>
                </a>

            </nav>

            <div class="sidebar-footer">
                Caso Práctico 1
                <small>Paradigmas de Programación</small>
            </div>

        </aside>

        <!-- Contenido del lado derecho -->
        <div class="main-wrapper">

            <header class="topbar">

                <button class="menu-toggle"
                        id="menuToggle"
                        type="button"
                        aria-label="Abrir o cerrar menú">
                    <i class="bi bi-list"></i>
                </button>

                <div class="topbar-title">
                    Sistema de Gestión de Biblioteca
                </div>

                <div class="topbar-user">
                    <i class="bi bi-person-circle"></i>
                    <span>Administrador</span>
                </div>

            </header>

            <main class="main-content">
                @RenderBody()
            </main>

            <footer class="app-footer">
                BiblioTech © @DateTime.Now.Year
                | Universidad Fidélitas
            </footer>

        </div>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
            document.getElementById("menuToggle")
                .addEventListener("click", function () {
                    document.getElementById("sidebar")
                        .classList.toggle("sidebar-open");
                });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>

